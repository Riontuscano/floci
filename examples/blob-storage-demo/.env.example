# Copy to .env and adjust. Every value is optional; these are the defaults.

# Port the app listens on, on the host machine.
# "192.168.1.206:6100" listens on that network address only.
APP_PORT=6100

# Only devices with an address in these ranges can use the app (comma-separated CIDR).
# Empty allows everyone who can reach the port. For an office Wi-Fi on 192.168.1.x:
#   ALLOWED_NETWORKS=192.168.1.0/24
ALLOWED_NETWORKS=

# Where data lives. A plain name is a Docker-managed volume.
# On a server, use host folders instead so backups are easy, for example:
#   FLOCI_DATA=/srv/blob/floci
#   APP_DATA=/srv/blob/app
FLOCI_DATA=floci-data
APP_DATA=app-data

S3_BUCKET=demo-uploads

# Upload limits.
MAX_UPLOAD_MB=15
MAX_FILES_PER_REQUEST=10

# Refuse uploads once stored originals reach this many GB. 0 means no limit.
# Resized copies are not counted: set this about 20% below the space you want to give.
STORAGE_QUOTA_GB=0

# Widths and heights the app may generate. Requested sizes snap up to the next one.
ALLOWED_SIZES=160,320,640,1024,1600

# How many images may be resized at the same time.
MAX_CONCURRENT_RESIZES=2

# Hard memory and CPU caps per container, so other services on the machine stay safe.
FLOCI_MEMORY=1g
FLOCI_CPUS=1.0
APP_MEMORY=512m
APP_CPUS=1.0
